# NoDRONE Co-Pilot Providers (add any one or more in AI Studio Settings -> Secrets)
# Nous Research Portal (supports Gemini, Claude, OpenAI, and open models via one prepaid key)
NOUS_API_KEY=
NOUS_BASE_URL=https://inference-api.nousresearch.com/v1
NOUS_MODEL=google/gemini-4-hydrogen

# Anthropic Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Gemini API (used for Gemini Live Voice + Co-Pilot fallback)
GEMINI_API_KEY=

# Optional provider override: auto | nous | anthropic | gemini
COPILOT_PROVIDER=auto

# Real-Time Site Weather & Global Map Tile Overlays
OPENWEATHERMAP_API_KEY=
